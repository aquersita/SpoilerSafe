rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public user profiles (read) — authenticated write
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      // Any authenticated user can increment/decrement followers_count (follow/unfollow)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers_count']);
    }
    // Following sub-collection — public read, owner write
    match /users/{uid}/following/{otherUid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Progress — only owner
    match /progress/{uid}/{type}/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Watchlist — only owner
    match /watchlist/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Favorites — only owner
    match /favorites/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Comments — read all, authenticated write
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    // Capsules — only owner reads their own
    match /capsules/{capsuleId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    // DMs — only participants
    // GET (single doc read) allows resource==null so getOrCreateConvo can check existence
    match /dms/{convoId} {
      allow get: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
    }
    match /dms/{convoId}/messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid;
    }
  }
}
