# Backend – copia este archivo como .env y rellena los valores

# Firebase – ruta al JSON de cuenta de servicio descargado de la consola de Firebase
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# JWT – cambia esto por una cadena larga y aleatoria en producción
SECRET_KEY=spoilersafe_cambia_esto_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS – dominios permitidos separados por comas
# En local:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# En producción (reemplaza con tu URL de Netlify):
# ALLOWED_ORIGINS=https://spoilersafe.netlify.app,http://localhost:5173
